// Merven Fashions catalogue schema.
//
// Conventions:
// - Money is stored as integer minor units (KES cents) with an explicit currency code.
// - Inventory lives on ProductVariant, never on Product.
// - Products are archived, not deleted, so future Order rows can safely reference variants.
// - Non-negative checks (stock, prices) are enforced by CHECK constraints in the migrations.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"] // Order.checkoutKey is unique only among unpaid orders
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("category")
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  details     String? // fabric, fit and care notes
  status      ProductStatus    @default(DRAFT)
  featured    Boolean          @default(false)
  priceMinor  Int
  currency    String           @default("KES") @db.Char(3)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  publishedAt DateTime? // first publication; slug is frozen once set
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([status, featured])
  @@index([categoryId, status])
  @@map("product")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  size       String
  colour     String
  colourHex  String?
  priceMinor Int? // overrides Product.priceMinor when set
  stock      Int      @default(0)
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, size, colour])
  @@map("product_variant")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String // Supabase object path (products/<productId>/<uuid>.webp), local dev path, or "placeholder:…"
  url        String
  alt        String
  width      Int
  height     Int
  /// The variant colour this photo shows (matches ProductVariant.colour); null = any colour.
  colour     String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_image")
}

// ---------------------------------------------------------------------------
// Administrator auth (Better Auth tables). There is no public sign-up; admins
// are created with `pnpm admin:create`.
// ---------------------------------------------------------------------------

model AdminUser {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  isActive      Boolean        @default(true) // deactivated admins fail requireAdmin()
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      AdminSession[]
  accounts      AdminAccount[]

  @@map("admin_user")
}

model AdminSession {
  id        String    @id
  expiresAt DateTime
  token     String    @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("admin_session")
}

model AdminAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("admin_account")
}

model AdminVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("admin_verification")
}

// Shared store for auth rate limiting (in-memory limits don't work on serverless).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---------------------------------------------------------------------------
// Online orders and payments (Paystack). Money is integer minor units (cents).
// Order, payment attempt and notification state are kept separate: a failed
// email never changes payment state, and a retry never overwrites an earlier
// attempt. Card data and raw provider payloads are never stored.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum StockStatus {
  NOT_APPLIED // order not paid yet
  DEDUCTED // stock decremented when payment was confirmed
  SHORTFALL // paid, but stock was insufficient for at least one line: needs owner action
}

enum PaymentStatus {
  INITIALIZING // row saved, provider not yet called (or call outcome unknown)
  PENDING // provider transaction exists; awaiting customer / confirmation
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED // gave up after the maximum attempts; visible in admin, can be retried
}

model Order {
  id             String              @id @default(cuid())
  reference      String              @unique // public, random, e.g. MRV-7K3Q9X2M4T (TEST-MRV-… in test mode)
  testMode       Boolean
  status         OrderStatus         @default(PENDING_PAYMENT)
  stockStatus    StockStatus         @default(NOT_APPLIED)
  customerName   String
  customerEmail  String
  customerPhone  String // E.164, e.g. +254712345678
  currency       String              @default("KES") @db.Char(3)
  subtotalMinor  Int
  totalMinor     Int // equals subtotal: delivery is not charged online yet
  needsAttention String? // e.g. duplicate payment or stock shortfall; for the owner
  // Bag checkouts only: HMAC of the browser's bag session and its basket. Two
  // submissions of the same bag converge on one unpaid order; once an order
  // leaves PENDING_PAYMENT the same basket can be ordered again. Null for Buy now.
  checkoutKey    String?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          OrderItem[]
  payments       PaymentAttempt[]
  notifications  EmailNotification[]

  @@index([status, createdAt])
  @@unique([checkoutKey], map: "order_pending_checkout_key", where: raw("\"status\" = 'PENDING_PAYMENT'"))
  @@map("order")
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  // Snapshot at checkout time: later catalogue edits never change an order.
  productId      String
  productName    String
  productSlug    String
  sku            String
  size           String
  colour         String
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int

  @@index([orderId])
  @@index([variantId])
  @@map("order_item")
}

model PaymentAttempt {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String        @default("paystack")
  reference             String        @unique // our transaction reference sent to Paystack
  testMode              Boolean
  status                PaymentStatus @default(INITIALIZING)
  amountMinor           Int
  currency              String        @db.Char(3)
  authorizationUrl      String?
  providerTransactionId String?       @unique
  channel               String? // e.g. card, mobile_money
  paidAt                DateTime?
  failureReason         String?
  lastVerifiedAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId, createdAt])
  @@map("payment_attempt")
}

model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String             @default("paystack")
  eventKey    String             @unique // provider + event + transaction id + status
  event       String
  reference   String?
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@map("webhook_event")
}

model EmailNotification {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind              String // "PAYMENT_RECEIPT"
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  lastError         String?
  nextAttemptAt     DateTime           @default(now())
  lockedAt          DateTime?
  sentAt            DateTime?
  providerMessageId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([orderId, kind]) // one receipt per order, however many webhooks arrive
  @@index([status, nextAttemptAt])
  @@map("email_notification")
}
