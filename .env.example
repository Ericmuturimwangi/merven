# --- Database ---------------------------------------------------------------
# Pooled connection string (e.g. Neon/Supabase pooler) used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/merven?sslmode=require"
# Separate, disposable database used by the integration tests. Its data is wiped.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/merven_test"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the deployed site, e.g. https://mervenfashions.co.ke
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp ---------------------------------------------------------------
# International format, digits only, no "+" (Kenya: 2547XXXXXXXX or 2541XXXXXXXX)
WHATSAPP_NUMBER=""

# --- Image storage ------------------------------------------------------------
# "supabase" in production (required on Vercel). "local" writes to LOCAL_UPLOAD_DIR
# and is for local development only.
IMAGE_STORAGE="local"
LOCAL_UPLOAD_DIR="./uploads"
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=""
# Server-only secret key (sb_secret_…). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
# Optional, only for `pnpm storage:verify` to prove browser keys can't write.
SUPABASE_PUBLISHABLE_KEY=""

# --- Online payments (Paystack) ----------------------------------------------------
# Fail-closed: checkout stays off unless every value below is valid for the
# deployment it runs on. Each deployment accepts only its own credentials:
#   local / preview → TEST mode only (sk_test_ key, test-marked database)
#   production      → LIVE mode only (sk_live_ key, database WITHOUT a test marker),
#                     and only on a Vercel production deployment whose
#                     NEXT_PUBLIC_SITE_URL is the project's production domain over https.
PAYMENTS_ENABLED="false"
# Required, no default: "local" (dev server on localhost, not on Vercel),
# "preview" (a Vercel Preview deployment with system variables exposed) or
# "production" (the Vercel production deployment, live mode). Anything else keeps
# checkout off.
# PAYMENTS_ENVIRONMENT=""
# Test mode only (local/preview): 24-128 chars of A-Z a-z 0-9 _ -. Must match the
# marker set on the (non-production) database with COMMENT ON DATABASE. Generate
# one per database, e.g. `openssl rand -hex 24`. Never set this marker on the
# production database, and never set this variable in production (it is refused).
# PAYMENTS_TEST_DATABASE_TOKEN=""
# "test" for local/preview, "live" for production. Must match the key below.
PAYSTACK_MODE="test"
# Server-only secret key; never NEXT_PUBLIC_. sk_test_… for test mode, sk_live_…
# for live mode. A live key is refused outside production and a test key in it.
PAYSTACK_SECRET_KEY=""
# Optional; allowed values: card, mobile_money (M-PESA).
PAYSTACK_CHANNELS="card,mobile_money"
# LOCAL QA ONLY: a loopback mock of the Paystack API (e.g. http://127.0.0.1:4010).
# PAYSTACK_API_BASE_URL=""

# --- Email receipts ---------------------------------------------------------------
# "resend" (needs RESEND_API_KEY + EMAIL_FROM), "gmail" (needs SMTP_USER +
# SMTP_PASSWORD), "log" (development: logs a masked line instead of sending), or
# empty (receipts stay queued, visible in the admin).
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM="Merven Fashions <receipts@your-verified-domain>"
# Gmail: the sending account and a Google *app password* (16 letters, created at
# myaccount.google.com/apppasswords; needs 2-Step Verification). Never the
# account's normal password. With gmail, EMAIL_FROM is optional and defaults to
# "Merven Fashions <SMTP_USER>".
SMTP_USER=""
SMTP_PASSWORD=""

# Where owner alerts go: possible duplicate payments, stock shortfalls, refunds and
# disputes reported by Paystack. Sent with the email provider above; unset keeps
# alerts queued. Alerts name the order and link to the admin, never the customer.
OWNER_ALERT_EMAIL=""

# Protects /api/cron/receipts, which retries unsent receipts and owner alerts daily
# (vercel.json). Vercel Cron sends it as "Authorization: Bearer <value>". 16+ random
# characters (e.g. `openssl rand -hex 24`); unset or shorter keeps the route off (503).
CRON_SECRET=""
