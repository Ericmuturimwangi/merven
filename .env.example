# --- Database ---------------------------------------------------------------
# Pooled connection string (e.g. Neon/Supabase pooler) used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/merven?sslmode=require"
# Separate, disposable database used by the integration tests. Its data is wiped.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/merven_test"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the deployed site, e.g. https://mervenfashions.co.ke
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp ---------------------------------------------------------------
# International format, digits only, no "+" (Kenya: 2547XXXXXXXX or 2541XXXXXXXX)
WHATSAPP_NUMBER=""

# --- Image storage ------------------------------------------------------------
# "supabase" in production (required on Vercel). "local" writes to LOCAL_UPLOAD_DIR
# and is for local development only.
IMAGE_STORAGE="local"
LOCAL_UPLOAD_DIR="./uploads"
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=""
# Server-only secret key (sb_secret_…). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
# Optional, only for `pnpm storage:verify` to prove browser keys can't write.
SUPABASE_PUBLISHABLE_KEY=""
